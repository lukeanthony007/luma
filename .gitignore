# Agent runtime state is not portable public knowledge.
**/.agents/memory/
**/.agents/cache/
**/.agents/runtime/
**/.credentials/

# Inbox interactions are temporary; retain only the empty-directory marker.
/inbox/*
!/inbox/.gitkeep

# Credentials and explicitly private material.
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
private/

# Local editor and device state.
.DS_Store
.idea/
.vscode/
.obsidian/workspace*.json

# Generated dependencies and transient output.
node_modules/
__pycache__/
*.pyc
