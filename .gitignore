# Preserved source evidence and runtime state stay out of public source.
**/.agents/memory/
**/.agents/cache/
**/.agents/runtime/
**/.credentials/

# Generated user knowledge and interactions stay out of this public foundation.
/inbox/
/wiki/

# Credentials and explicitly private material.
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
private/

# Local editor and device state.
.DS_Store
.idea/
.vscode/
.obsidian/workspace*.json

# Generated dependencies and transient output.
node_modules/
__pycache__/
*.pyc
